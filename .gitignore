# Dependencies
node_modules/

# Build output
dist/

# Test artifacts
coverage/
.nyc_output/
**/__snapshots__/__diff__/
**/__snapshots__/__failed__/

# Generated files (auto-generated during build)
src/components/icon/types/code-list.generated.ts
src/components/icon/_icon-variables.generated.scss
src/components/icon/web-component-combined.generated.scss
src/components/icon/fonts/
src/styles/_defined.generated.scss
.build-temp/

# Generated by bin/generate-styles-ts.cjs (Lit css-tagged-template wrappers around compiled SCSS)
src/**/*.styles.ts

# Generated by bin/generate-svg-modules.cjs (string-default-export wrappers around .svg files)
src/**/*.svg.ts

# Generated by npm run i18n:compile (compiled Lingui catalogs)
src/i18n/locales/*.ts

# Generated type declarations in test directory (should not be committed)
test/**/*.d.ts

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo

/docs
/data/dashboard/docs/
/.cache
dist/**/*.mjs
bin/temp-example-*.ts
.claude/settings.json
.cursor/

# Superpowers brainstorming companion (local mockups)
.superpowers/

# --- Python (ml-service) ---
ml-service/.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
# Los .pkl SÍ se versionan: son artefactos derivados de datos SIMULADOS (sin
# PII), pesan 1.9 MB y sin ellos el cerebro no arranca en un deploy por git.
# Los parquets de entrenamiento (abajo) siguen fuera: esos sí son datos crudos.
ml-service/data_clean/*.parquet

# --- Env / secrets ---
.env
.env.local
*.local

# --- Next.js (web) ---
web/.next/
web/out/
web/node_modules/
web/next-env.d.ts

# --- apps/web (journey del compañero) ---
apps/web/node_modules/
apps/web/dist/

# Next.js build en la raíz (no debe commitearse)
/.next/

# NOTA: web/data/*.json y web/contract/ SÍ se versionan. Son copias que genera
# web/scripts/copiar-datos-raiz.mjs (prebuild) desde la raíz, y tienen que estar
# en el repo porque al desplegar con el CLI de Vercel solo se sube web/.
# El original sigue siendo el de la raíz: el prebuild las refresca en cada build.

# Corpus descargado (1,6 GB) y caché de embeddings: se regeneran con
# scripts/indexar-sentencias.mjs
.cache/
