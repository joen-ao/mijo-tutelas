# ============================================================================
#  Variables de entorno — Mijo
# ----------------------------------------------------------------------------
#  Copiar así:
#     ml-service/  ->  cp ../.env.example .env
#     web/         ->  cp ../.env.example .env.local
#
#  ⚡ LA DEMO CORRE SIN NINGUNA CLAVE. Todo lo de abajo marcado [OPCIONAL] solo
#     se necesita para el canal WhatsApp real (Twilio), el LLM flexible (Gemini)
#     o persistencia en Supabase. Sin ellas, el sistema degrada y sigue andando.
# ============================================================================

# ---------------------------------------------------------------------------
# [OBLIGATORIO] Secreto compartido web <-> cerebro ML (invéntate uno)
# Debe COINCIDIR en ml-service/.env y web/.env.local
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# [OBLIGATORIO EN PRODUCCIÓN · web/.env.local] Contraseña del panel del asesor
#
# Cierra /api/dev/* (dispara la cadena completa: Gemini + Chromium)
# e ingresos. Esta clave es la puerta.
#   · VACÍA en desarrollo  -> el panel abre sin pedir nada (demo local de siempre)
#   · VACÍA en producción  -> el panel responde 503 (nunca queda abierto por olvido)
# En Vercel NO va en un archivo: se configura en Settings -> Environment Variables.
# Al cambiarla se invalidan todas las sesiones abiertas (la firma deriva de ella).
# ---------------------------------------------------------------------------
DASHBOARD_PASSWORD=

# Opcional: secreto propio para firmar la cookie de sesión. Si se omite, la
# firma se deriva de DASHBOARD_PASSWORD, que para la demo es suficiente.
SESSION_SECRET=

# ---------------------------------------------------------------------------
# [OPCIONAL · web/.env.local] Journey "El camino a tu hogar" (app aparte)
#
# El canal web del compañero es una app Vite independiente (apps/web), no una
# ruta de este Next. El sidebar la enlaza en la sección Cliente.
#   · VACÍA en desarrollo -> cae a http://localhost:5173
#   · VACÍA en producción -> el ítem no se muestra (mejor sin enlace que con uno
#     muerto en plena demo)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_JOURNEY_URL=

# ---------------------------------------------------------------------------
# [ml-service/.env] Config del cerebro (prefijo ML_)
# ---------------------------------------------------------------------------
ML_MODEL_VERSION=desist-v1
ML_RECOMMENDER_VERSION=cos-v1

# ---------------------------------------------------------------------------
# [web/.env.local] Cómo el web llama al cerebro
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# [OPCIONAL · WhatsApp real] Twilio Sandbox + ngrok (T19)
#   1. Crea cuenta en twilio.com → Messaging → Try WhatsApp (Sandbox).
#   2. Corre ngrok:  ngrok http 3000   → copia la URL https pública.
#   3. En el Sandbox, "When a message comes in" =  https://XXXX.ngrok.io/api/whatsapp
#   4. Únete al sandbox enviando el código por WhatsApp al número que te dan.
#   Sin esto: usa el simulador de chat en /chat (misma lógica, sin teléfono).
# ---------------------------------------------------------------------------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=            # si lo pones, se valida la firma X-Twilio-Signature
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
TWILIO_VOICE_FROM=            # número Twilio CON voz (el sandbox de WhatsApp NO sirve para llamar)

# ---------------------------------------------------------------------------
# [OPCIONAL · LLM flexible] Gemini (A8). Plan B: Qwen.
#   Consíguela en https://aistudio.google.com/apikey  (el evento da $300 crédito).
#   Sin esto: el bot interpreta con reglas (regex) — funciona, menos flexible.
# ---------------------------------------------------------------------------
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ---------------------------------------------------------------------------
# [OPCIONAL · Voz] ElevenLabs TTS — el asesor manda audios por WhatsApp
#   API key: elevenlabs.io → perfil → API Keys (empieza con sk_...).
#   VOICE_ID: elige una voz en español en tu Voice Library y pega su id.
#   Sin esto: el bot manda solo texto (degradación).
# ---------------------------------------------------------------------------
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=EXAVITQu4vr4xnSDxMaL
ELEVENLABS_MODEL=eleven_multilingual_v2

# ---------------------------------------------------------------------------
# [OPCIONAL · Persistencia] Supabase (T13/T14). Sin esto, el web usa seed.json
#   local + casos en memoria (se pierden al reiniciar; suficiente para demo).
#   Para producción:  supabase db push (migración 0001) + node scripts/seed.mjs
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=   # solo para el seed (scripts/seed.mjs)

# ---------------------------------------------------------------------------
# [OPCIONAL · Deploy del cerebro] DigitalOcean ($200 crédito) o Hugging Face.
#   El web va a Vercel. Ajusta ML_SERVICE_URL a la URL pública del microservicio.
# ---------------------------------------------------------------------------

# --- Mijo · render del PDF de la tutela ---------------------------------------
# Base INTERNA que abre Chromium para imprimir /tutela. Se deja en localhost a
# propósito: por ngrok (plan free) se cuela una página de advertencia que
# arruinaría el documento. Solo cambiar si el server no corre en el mismo host.
TUTELA_INTERNAL_BASE=http://localhost:3000

# --- Seguridad del webhook -----------------------------------------------------
# La firma de Twilio solo se exige sola en producción (ver lib/twilioFirma.ts).
# Con ngrok estás en "desarrollo" pero EXPUESTO a internet: sin esto, cualquiera
# que dé con la URL puede forjar mensajes entrantes y quemar créditos de Gemini y
# ElevenLabs. Ponlo en true siempre que levantes el túnel.
WHATSAPP_VERIFY_SIGNATURE=true

# --- Correo (Resend) · radicación ----------------------------------------------
RESEND_API_KEY=
# OJO: con onboarding@resend.dev (el dominio compartido de Resend) SOLO se puede
# enviar al dueño de la cuenta, tenga o no dominios verificados. Para enviarle a
# cualquier otra persona hay que remitir DESDE un dominio propio verificado en
# resend.com/domains. El buzón no tiene que existir: se valida el dominio.
CORREO_FROM="Mijo <tutelas@tu-dominio.co>"

# ⚠️ SEGURIDAD — LEER ANTES DE TOCAR
# Con REPARTO_OVERRIDE_EMAIL definida, NINGÚN correo llega a una Oficina Judicial
# real: todos se redirigen aquí. Radicar una tutela de prueba ocupa un turno de
# reparto y el tiempo de un juez que le corresponde a alguien con un caso real.
# Esta variable se quita SOLO en producción, y es el único cambio necesario.
# Admite varios destinatarios separados por coma.
REPARTO_OVERRIDE_EMAIL=tu-correo@ejemplo.com
# Igual para el correo de la persona: Resend sin dominio verificado solo entrega
# al dueño de la cuenta.
USUARIO_OVERRIDE_EMAIL=tu-correo@ejemplo.com

# --- Seguimiento (cron externo) ------------------------------------------------
# Protege POST /api/seguimiento, que ESCRIBE por WhatsApp a los usuarios. Sin
# esta variable la ruta responde 503 y no hace nada.
#   curl -X POST https://<host>/api/seguimiento -H "Authorization: Bearer $SEGUIMIENTO_TOKEN"
SEGUIMIENTO_TOKEN=

# --- Landing (públicas, van en Vercel) -----------------------------------------
# Son las ÚNICAS variables que necesita la página pública. Sin ellas la landing
# usa placeholders que NO reciben nada: los botones de WhatsApp y de llamada
# quedan muertos aunque la página se vea bien.
# Formato: indicativo + número, sin signos ni espacios.
NEXT_PUBLIC_WHATSAPP_NUMBER=573000000000
# La línea a la que llama quien no tiene WhatsApp. Formato E.164.
NEXT_PUBLIC_PHONE_NUMBER=+576010000000

# OJO: NO subas a Vercel GEMINI_API_KEY, TWILIO_*, RESEND_API_KEY ni las de
# Supabase. La landing no las usa, y el BOT no puede correr en serverless (ver
# la sección "Despliegue" del README: entrega asíncrona, estado en memoria y
# Chromium). El bot va en un proceso Node persistente.
